# Only source needed for the capture bundle and its runtime enters BuildKit.
*
!capture
!electron
!src
!shared
shared/*
!shared/capture
!build
build/*
!build/prepare-adblock.ts
!deploy
deploy/*
!deploy/docker
deploy/docker/*
!deploy/docker/shelfy-capture-runtime
!deploy/capture-isolation-check.sh
!deploy/fixtures
deploy/fixtures/*
!deploy/fixtures/capture
!scripts
scripts/*
!scripts/spikes
scripts/spikes/*
!scripts/spikes/ssrf-probe.mjs
**/node_modules
**/dist
**/.DS_Store
**/.env*
