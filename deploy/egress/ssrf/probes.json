{
  "_doc": "SSRF probe list for the Shelfy egress proxy (plan §6.1, §7.1; SPIKE-4 categories A-L). crates/server/tests/ssrf.rs drives it through the API's real outbound client against a live Smokescreen (SHELFY_SSRF_PROXY); P4-13's capture-isolation-check.sh reuses it inside the capture container. Each probe is refused, or (category A) allowed, so the suite proves both directions. The test resolver (deploy/egress/ssrf/Corefile) answers the names below; the fixture subnet is the one the test configuration allows with --allow-range.",
  "version": 1,
  "fixture_subnet": "10.133.0.0/24",
  "via": {
    "client": "sent through the API's outbound client (Egress, purpose Link); https targets tunnel with CONNECT",
    "raw-connect": "a raw CONNECT host:port line written to the proxy (the bytes under test, unnormalised)",
    "raw-http": "a raw absolute-form GET written to the proxy"
  },
  "by": {
    "client": "the outbound client refuses the URL before the proxy sees it (literal non-public address, bad port/scheme, localhost); 'refusal' is the Refusal code, or 'any' when the URL crate may instead reject the spelling as invalid",
    "proxy": "the proxy refuses it: a 407 or X-Smokescreen-Error, or a DNS failure at the proxy; client probes surface this as Refusal::Proxy"
  },
  "probes": [
