# Shelfy backups (plan §3.5): back up the media stores with restic, set
# "media". Started daily by shelfy-media-backup.timer; the osn role `shelfy`
# installs the scripts in /opt/osn/stack/shelfy/backup/.
[Unit]
Description=Shelfy: back up the media stores (restic, set media)
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/shelfy/backup.env
ExecStart=/opt/osn/stack/shelfy/backup/shelfy-media-backup.sh
TimeoutStartSec=6h
Nice=19
IOSchedulingClass=idle
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=full
